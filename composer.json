{
    "name": "doctee/symcon-ai-framework",
    "description": "Reusable engineering framework for IP-Symcon automation projects.",
    "type": "project",
    "license": "PolyForm-Noncommercial-1.0.0",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "squizlabs/php_codesniffer": "^3.13"
    },
    "scripts": {
        "bundle:build": [
            "@php tools/build-symcon-bundle.php bundles/symcon/ensure-variable.bundle.json"
        ],
        "bundle:check": [
            "@php tools/build-symcon-bundle.php --check bundles/symcon/ensure-variable.bundle.json"
        ],
        "fileset:build": [
            "@php tools/build-symcon-fileset.php deployments/symcon/mqtt-discovery-exporter.fileset.json"
        ],
        "fileset:check": [
            "@php tools/build-symcon-fileset.php --check deployments/symcon/mqtt-discovery-exporter.fileset.json"
        ],
        "control-light:fileset-build": [
            "@php tools/build-symcon-fileset.php deployments/symcon/control-light.fileset.json"
        ],
        "control-light:fileset-check": [
            "@php tools/build-symcon-fileset.php --check deployments/symcon/control-light.fileset.json"
        ],
        "media-carousel:fileset-build": [
            "@php tools/build-symcon-module-fileset.php deployments/symcon/media-carousel-module.fileset.json"
        ],
        "media-carousel:fileset-check": [
            "@php tools/build-symcon-module-fileset.php --check deployments/symcon/media-carousel-module.fileset.json"
        ],
        "navimow:fileset-build": [
            "@php tools/build-symcon-module-fileset.php deployments/symcon/navimow-module.fileset.json"
        ],
        "navimow:fileset-check": [
            "@php tools/build-symcon-module-fileset.php --check deployments/symcon/navimow-module.fileset.json"
        ],
        "open-meteo:publication-check": [
            "@php tools/publish-open-meteo-module.php --check"
        ],
        "media-carousel:publication-check": [
            "@php tools/publish-symcon-module.php --contract=deployments/symcon/media-carousel-publication.json --check"
        ],
        "navimow:publication-check": [
            "@php tools/publish-symcon-module.php --contract=deployments/symcon/navimow-publication.json --check"
        ],
        "test:bundles": [
            "@php tests/bundles/ensure-variable-bundle.php"
        ],
        "test:filesets": [
            "@php tests/bundles/mqtt-discovery-exporter-fileset.php"
        ],
        "test:control-light-fileset": [
            "@php tests/bundles/control-light-fileset.php"
        ],
        "test:deployment-restart": [
            "@php tests/deployments/windows-restart-coordinator.php"
        ],
        "test:deployment-channel": [
            "@php tests/deployments/windows-deployment-channel.php",
            "@php tests/deployments/windows-retention.php"
        ],
        "test:runtime-source-mirror": [
            "@php tests/deployments/runtime-source-mirror.php"
        ],
        "test:runtime-health-probe": [
            "@php tests/deployments/runtime-health-probe.php"
        ],
        "test:helpers": [
            "@php tests/helpers/object-mutation-safety.php",
            "@php tests/helpers/diagnostics.php",
            "@php tests/helpers/ensure-event.php",
            "@php tests/helpers/ensure-presentation.php",
            "@php tests/helpers/public-api.php",
            "@php tests/helpers/wait-for-variable.php"
        ],
        "test:mqtt-exporter-core": [
            "@php tests/mqtt-discovery-exporter/core.php"
        ],
        "test:mqtt-exporter-runtime": [
            "@php tests/mqtt-discovery-exporter/runtime-diagnostics.php"
        ],
        "test:mqtt-exporter-reconcile": [
            "@php tests/mqtt-discovery-exporter/prepare-reconcile.php"
        ],
        "test:mqtt-exporter-execute": [
            "@php tests/mqtt-discovery-exporter/execute-reconcile.php"
        ],
        "test:mqtt-exporter-dispatch": [
            "@php tests/mqtt-discovery-exporter/dispatch.php"
        ],
        "test:mqtt-exporter-cleanup": [
            "@php tests/mqtt-discovery-exporter/cleanup.php"
        ],
        "test:mqtt-exporter-fixtures": [
            "@php tests/mqtt-discovery-exporter/discovery-fixtures.php"
        ],
        "test:control-light-core": [
            "@php tests/control-light/core.php"
        ],
        "test:control-light-color-analysis": [
            "@php tests/control-light/color-conversion-analysis.php"
        ],
        "test:control-light-runtime": [
            "@php tests/control-light/runtime.php"
        ],
        "test:manual-on-pulse-off": [
            "@php tests/control-light/manual-on-pulse-off-core.php",
            "@php tests/control-light/manual-on-pulse-off-runtime.php"
        ],
        "test:control-light-group-runtime": [
            "@php tests/control-light/group-runtime.php"
        ],
        "test:control-light-topology": [
            "@php tests/control-light/topology.php"
        ],
        "test:control-light-runtime-mirror": [
            "@php tests/control-light/runtime-mirror.php"
        ],
        "test:hue-wall-core": [
            "@php tests/control-light/hue-wall-core.php"
        ],
        "test:hue-wall-runtime": [
            "@php tests/control-light/hue-wall-runtime.php"
        ],
        "test:hue-wall-topology": [
            "@php tests/control-light/hue-wall-topology.php"
        ],
        "test:navimow-rest-auth": [
            "@php case-studies/navimow/tests/rest-client-auth.php"
        ],
        "test:navimow-pilot": [
            "@php case-studies/navimow/tests/pilot-observation-harness.php"
        ],
        "test:navimow-mqtt": [
            "case-studies/navimow/tools/check-mqtt-shadow.sh"
        ],
        "test:navimow-distribution": [
            "@php case-studies/navimow/tools/validate-distribution.php"
        ],
        "test:media-carousel": [
            "@php case-studies/media-carousel/tests/module.php",
            "@php case-studies/media-carousel/tools/validate-distribution.php",
            "@php case-studies/media-carousel/tests/module-fileset.php"
        ],
        "test:module-publication": [
            "@php case-studies/open-meteo/tests/publication.php",
            "@php tests/publication/module-publication.php"
        ],
        "test:toolchain-resolution": [
            "tests/toolchain/vendor-resolution.sh"
        ],
        "lint": [
            "@php tools/lint.php"
        ],
        "phpstan": [
            "phpstan analyse --memory-limit=512M --debug --no-progress"
        ],
        "phpstan:bundle": [
            "phpstan analyse --memory-limit=512M --debug --no-progress -c phpstan-bundle.neon"
        ],
        "phpcs": [
            "phpcs"
        ],
        "check": [
            "@test:toolchain-resolution",
            "@lint",
            "@bundle:check",
            "@fileset:check",
            "@control-light:fileset-check",
            "@media-carousel:fileset-check",
            "@navimow:fileset-check",
            "@open-meteo:publication-check",
            "@media-carousel:publication-check",
            "@navimow:publication-check",
            "@test:bundles",
            "@test:filesets",
            "@test:control-light-fileset",
            "@test:deployment-restart",
            "@test:deployment-channel",
            "@test:runtime-source-mirror",
            "@test:runtime-health-probe",
            "@test:helpers",
            "@test:mqtt-exporter-core",
            "@test:mqtt-exporter-runtime",
            "@test:mqtt-exporter-reconcile",
            "@test:mqtt-exporter-execute",
            "@test:mqtt-exporter-dispatch",
            "@test:mqtt-exporter-cleanup",
            "@test:mqtt-exporter-fixtures",
            "@test:control-light-core",
            "@test:control-light-color-analysis",
            "@test:control-light-runtime",
            "@test:manual-on-pulse-off",
            "@test:control-light-group-runtime",
            "@test:control-light-topology",
            "@test:control-light-runtime-mirror",
            "@test:hue-wall-core",
            "@test:hue-wall-runtime",
            "@test:hue-wall-topology",
            "@test:navimow-rest-auth",
            "@test:navimow-pilot",
            "@test:navimow-mqtt",
            "@test:navimow-distribution",
            "@test:media-carousel",
            "@test:module-publication",
            "@phpstan",
            "@phpstan:bundle",
            "@phpcs"
        ]
    }
}
