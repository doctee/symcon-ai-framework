{
  "elements": [
    {
      "type": "CheckBox",
      "name": "LocationConfigured",
      "caption": "Location configuration is complete"
    },
    {
      "type": "ValidationTextBox",
      "name": "LocationKey",
      "caption": "Stable location key"
    },
    {
      "type": "NumberSpinner",
      "name": "Latitude",
      "caption": "Latitude",
      "minimum": -90,
      "maximum": 90,
      "digits": 6
    },
    {
      "type": "NumberSpinner",
      "name": "Longitude",
      "caption": "Longitude",
      "minimum": -180,
      "maximum": 180,
      "digits": 6
    },
    {
      "type": "CheckBox",
      "name": "UseElevation",
      "caption": "Use explicit elevation"
    },
    {
      "type": "NumberSpinner",
      "name": "Elevation",
      "caption": "Elevation in metres",
      "minimum": -500,
      "maximum": 9000,
      "digits": 1
    },
    {
      "type": "ValidationTextBox",
      "name": "Timezone",
      "caption": "IANA time zone"
    }
  ],
  "actions": [
    {
      "type": "Label",
      "caption": "This instance only provides a validated location descriptor; it creates no child objects and performs no network requests."
    }
  ]
}
