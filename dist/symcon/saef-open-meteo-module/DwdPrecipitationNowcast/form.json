{
  "elements": [
    {
      "type": "SelectInstance",
      "name": "LocationInstanceId",
      "caption": "Shared location instance",
      "validModules": [
        "{3B6B9CB0-8D95-4358-874A-13FF1A8BECD1}"
      ]
    },
    {
      "type": "NumberSpinner",
      "name": "ForecastWindowMinutes",
      "caption": "Evaluation window in minutes",
      "minimum": 5,
      "maximum": 120,
      "digits": 0
    },
    {
      "type": "NumberSpinner",
      "name": "RainThresholdMmPerHour",
      "caption": "Rain threshold in millimetres per hour",
      "minimum": 0.01,
      "maximum": 1000,
      "digits": 2
    },
    {
      "type": "CheckBox",
      "name": "EnableAutomaticUpdates",
      "caption": "Enable automatic updates"
    },
    {
      "type": "NumberSpinner",
      "name": "PollingIntervalMinutes",
      "caption": "Polling interval in minutes",
      "minimum": 5
    },
    {
      "type": "NumberSpinner",
      "name": "PollingOffsetSeconds",
      "caption": "Polling offset in seconds (-1 = automatic)",
      "minimum": -1,
      "maximum": 120,
      "digits": 0
    },
    {
      "type": "NumberSpinner",
      "name": "HttpTimeoutSeconds",
      "caption": "HTTP timeout in seconds",
      "minimum": 1,
      "maximum": 60
    },
    {
      "type": "NumberSpinner",
      "name": "StaleAfterMinutes",
      "caption": "Stale threshold in minutes",
      "minimum": 5
    }
  ],
  "actions": [
    {
      "type": "Button",
      "caption": "Update DWD nowcast now",
      "onClick": "echo DWDNOWCAST_UpdateData($id);"
    },
    {
      "type": "Label",
      "caption": "The DWD radar product has a native resolution of five minutes and a maximum horizon of 120 minutes."
    }
  ]
}
