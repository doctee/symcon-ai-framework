{
  "elements": [
    {
      "type": "SelectInstance",
      "name": "WeatherInstanceId",
      "caption": "Open-Meteo Weather instance",
      "validModules": [
        "{B52FE951-7FBE-4882-B0E6-E143E5B5F31A}"
      ]
    },
    {
      "type": "NumberSpinner",
      "name": "ForecastDays",
      "caption": "Forecast days",
      "minimum": 1,
      "maximum": 7
    },
    {
      "type": "Select",
      "name": "ForecastOutputMode",
      "caption": "Forecast output",
      "options": [
        {
          "caption": "Direct AC output",
          "value": "direct_ac"
        },
        {
          "caption": "PV harvest before storage dispatch",
          "value": "pv_harvest"
        }
      ]
    },
    {
      "type": "CheckBox",
      "name": "EnableAutomaticUpdates",
      "caption": "Enable automatic updates"
    },
    {
      "type": "NumberSpinner",
      "name": "PollingIntervalMinutes",
      "caption": "Polling interval in minutes",
      "minimum": 30
    },
    {
      "type": "ValidationTextBox",
      "name": "ArraysJson",
      "caption": "PV arrays JSON"
    },
    {
      "type": "ValidationTextBox",
      "name": "InvertersJson",
      "caption": "Inverter groups JSON"
    },
    {
      "type": "CheckBox",
      "name": "EnableShadingProfile",
      "caption": "Enable shading profile"
    },
    {
      "type": "CheckBox",
      "name": "EnableCalibration",
      "caption": "Enable calibration"
    },
    {
      "type": "NumberSpinner",
      "name": "HttpTimeoutSeconds",
      "caption": "HTTP timeout in seconds",
      "minimum": 1,
      "maximum": 60
    },
    {
      "type": "NumberSpinner",
      "name": "StaleAfterMinutes",
      "caption": "Stale threshold in minutes",
      "minimum": 30
    }
  ],
  "actions": [
    {
      "type": "Button",
      "caption": "Update solar forecast now",
      "onClick": "echo OMSOLAR_UpdateData($id);"
    },
    {
      "type": "Label",
      "caption": "Automatic updates default to off and ApplyChanges never performs a request."
    },
    {
      "type": "Label",
      "caption": "Installation-specific PV data belongs in private configuration and must not be committed."
    }
  ]
}
