<?xml version="1.0"?>
<ruleset name="SAEF">
    <description>SAEF Coding Standard</description>

    <rule ref="PSR12">
        <exclude name="PSR1.Files.SideEffects"/>
        <exclude name="PSR1.Classes.ClassDeclaration.MissingNamespace"/>
        <exclude name="PSR1.Methods.CamelCapsMethodName.NotCamelCaps"/>
        <exclude name="PSR12.Files.FileHeader"/>
        <exclude name="Squiz.Commenting.FileComment"/>
        <exclude name="Generic.Files.LineLength"/>
    </rule>

    <file>helpers</file>
    <file>templates</file>
    <file>examples</file>
    <file>tools</file>
    <file>tests/bundles</file>
    <file>tests/control-light</file>
    <file>tests/deployments</file>
    <file>tests/helpers</file>
    <file>tests/mqtt-discovery-exporter</file>
    <file>tests/publication</file>
    <file>deployments/symcon/windows/SaefRuntimeSourceMirror.php</file>
    <file>deployments/symcon/windows/SaefRuntimeHealthProbe.php</file>
    <file>case-studies/control-light/candidate</file>
    <file>case-studies/mqtt-discovery-exporter/candidate</file>
    <file>case-studies/navimow/distribution</file>
    <file>case-studies/navimow/tools</file>
    <file>case-studies/media-carousel/distribution</file>
    <file>case-studies/media-carousel/tools</file>
    <file>case-studies/owntracks-position-map/candidate</file>
    <file>case-studies/owntracks-position-map/distribution</file>
    <file>case-studies/owntracks-position-map/tests</file>
    <file>case-studies/owntracks-position-map/tools</file>

    <rule ref="PSR1.Classes.ClassDeclaration.MultipleClasses">
        <exclude-pattern>case-studies/navimow/distribution/libs/Navimow/ApiClient.php</exclude-pattern>
    </rule>

    <exclude-pattern>vendor/*</exclude-pattern>
    <exclude-pattern>case-studies/media-carousel/distribution/MediaCarousel/carousel.js</exclude-pattern>
    <exclude-pattern>case-studies/owntracks-position-map/candidate/renderer/renderer.js</exclude-pattern>
    <exclude-pattern>case-studies/owntracks-position-map/candidate/openlayers/*</exclude-pattern>
</ruleset>
