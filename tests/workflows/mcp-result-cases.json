{
  "description": "Synthetic decision examples, not captured server receipts. Review fields are explicit human/agent interpretations, not native server fields.",
  "baseline": {
    "channel": "native",
    "phase": "change",
    "dispatched": true,
    "transportOk": true,
    "complete": true,
    "allContentReviewed": true,
    "response": {
      "isError": false,
      "content": [{"type": "text", "text": "File saved."}]
    },
    "semanticVerdict": "pass",
    "savedConfirmed": true,
    "requiresLint": true,
    "fileLint": "pass",
    "folderLint": "pass",
    "validation": "pass",
    "readback": "match",
    "reloadRequired": false,
    "reloadVerdict": "not-required",
    "domainAcceptance": "pass"
  },
  "cases": [
    {"id": "native-independent-checks", "changes": {}, "expected": "verified"},
    {"id": "native-optional-is-error", "changes": {"response": {"content": [{"type": "text", "text": "File saved."}]}}, "expected": "verified"},
    {"id": "write-false-with-syntax-warning", "changes": {"response": {"isError": false, "content": [{"type": "text", "text": "File saved."}, {"type": "text", "text": "WARNING: PHP syntax error."}]}, "semanticVerdict": "fail", "fileLint": "fail"}, "expected": "written-invalid"},
    {"id": "edit-failure-contract", "changes": {"response": {"isError": true, "content": [{"type": "text", "text": "Exact replacement not found."}]}, "savedConfirmed": false, "semanticVerdict": "fail"}, "expected": "failed"},
    {"id": "file-lint-failed", "changes": {"fileLint": "fail"}, "expected": "written-invalid"},
    {"id": "folder-lint-failed", "changes": {"folderLint": "fail"}, "expected": "written-invalid"},
    {"id": "lint-response-error", "changes": {"savedConfirmed": false, "response": {"isError": true, "content": [{"type": "text", "text": "Syntax error."}]}, "semanticVerdict": "fail"}, "expected": "failed"},
    {"id": "write-included-lint-not-sufficient", "changes": {"fileLint": "unknown", "folderLint": "unknown"}, "expected": "uncertain"},
    {"id": "folder-lint-not-checked", "changes": {"folderLint": "unknown"}, "expected": "uncertain"},
    {"id": "semantic-failure-despite-ok", "changes": {"response": {"isError": false, "content": [{"type": "text", "text": "Registration error."}, {"type": "text", "text": "OK"}]}, "semanticVerdict": "fail"}, "expected": "failed"},
    {"id": "unreviewed-content", "changes": {"allContentReviewed": false}, "expected": "uncertain"},
    {"id": "unfamiliar-semantics", "changes": {"semanticVerdict": "unknown"}, "expected": "uncertain"},
    {"id": "incomplete-response", "changes": {"complete": false}, "expected": "uncertain"},
    {"id": "lost-mutation-response", "changes": {"transportOk": false, "savedConfirmed": false, "response": null}, "expected": "uncertain"},
    {"id": "invalid-error-flag-type", "changes": {"response": {"isError": "false", "content": [{"type": "text", "text": "OK"}]}}, "expected": "uncertain"},
    {"id": "empty-response", "changes": {"response": {}}, "expected": "uncertain"},
    {"id": "missing-readback", "changes": {"readback": "unknown"}, "expected": "uncertain"},
    {"id": "readback-drift", "changes": {"readback": "mismatch"}, "expected": "failed"},
    {"id": "metadata-invalid", "changes": {"validation": "fail"}, "expected": "failed"},
    {"id": "metadata-unchecked", "changes": {"validation": "unknown"}, "expected": "uncertain"},
    {"id": "reload-instance-error", "changes": {"reloadRequired": true, "reloadVerdict": "fail"}, "expected": "failed"},
    {"id": "reload-unverified", "changes": {"reloadRequired": true, "reloadVerdict": "unknown"}, "expected": "uncertain"},
    {"id": "reload-all-verdicts-passed", "changes": {"reloadRequired": true, "reloadVerdict": "pass"}, "expected": "verified"},
    {"id": "domain-regression", "changes": {"domainAcceptance": "fail"}, "expected": "failed"},
    {"id": "domain-not-observed", "changes": {"domainAcceptance": "unknown"}, "expected": "uncertain"},
    {"id": "rollback-readback-drift", "changes": {"phase": "rollback", "readback": "mismatch"}, "expected": "recovery-required"},
    {"id": "rollback-lint-error", "changes": {"phase": "rollback", "fileLint": "fail"}, "expected": "recovery-required"},
    {"id": "rollback-timeout", "changes": {"phase": "rollback", "transportOk": false}, "expected": "recovery-required"},
    {"id": "rollback-verified", "changes": {"phase": "rollback"}, "expected": "recovered"},
    {"id": "non-php-validations", "changes": {"requiresLint": false, "fileLint": "not-required", "folderLint": "not-required"}, "expected": "verified"},
    {"id": "legacy-explicit-success", "changes": {"channel": "legacy", "response": {"transportError": null, "executionError": null, "truncated": false}}, "expected": "verified"},
    {"id": "legacy-missing-fields", "changes": {"channel": "legacy", "response": {"isError": false}}, "expected": "uncertain"},
    {"id": "legacy-truncated", "changes": {"channel": "legacy", "response": {"transportError": null, "executionError": null, "truncated": true}}, "expected": "uncertain"},
    {"id": "legacy-execution-error", "changes": {"channel": "legacy", "response": {"transportError": null, "executionError": "Synthetic failure", "truncated": false}}, "expected": "failed"},
    {"id": "legacy-transport-error", "changes": {"channel": "legacy", "response": {"transportError": "Lost response", "executionError": null, "truncated": false}}, "expected": "uncertain"},
    {"id": "unknown-channel", "changes": {"channel": "unverified"}, "expected": "uncertain"}
  ]
}
