parameters:
    level: 5
    phpVersion: 80200

    parallel:
        maximumNumberOfProcesses: 1

    paths:
        - helpers
        - templates
        - examples
        - tools
        - deployments/symcon/windows/SaefRuntimeSourceMirror.php
        - deployments/symcon/windows/SaefRuntimeHealthProbe.php
        - case-studies/control-light/candidate
        - case-studies/mqtt-discovery-exporter/candidate
        - case-studies/navimow/distribution
        - case-studies/media-carousel/distribution
        - case-studies/owntracks-position-map/candidate

    # Executable test entrypoints define mutually incompatible global Symcon
    # fakes. They are linted and executed by the Composer test scripts, but must
    # not share one PHPStan symbol table with production candidates or another
    # fake family. See standards/TESTING_STANDARDS.md, section 9.

    bootstrapFiles:
        - stubs/symcon.php

    excludePaths:
        - vendor/*

    treatPhpDocTypesAsCertain: true

    ignoreErrors:
        - identifier: variable.undefined
